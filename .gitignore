# ============================================
# SECRETS — added for NoteMate
# ============================================

# Gemini API key (real values) — teammates copy lib/config/api_config.example.dart instead
lib/config/api_config.dart

# Firebase config — contains SHA-1-linked OAuth client info
android/app/google-services.json

# Android release signing (Play Store keystore)
*.jks
*.keystore
key.properties
android/key.properties

# Environment variables, if ever added
.env

# Firebase local cache/logs
.firebase/
firebase-debug.log
firestore-debug.log


# ============================================
# BACKEND (functions/) — only relevant if this .gitignore
# sits at the repo ROOT, not inside frontend/. If this file
# lives at frontend/.gitignore instead, the backend teammate
# needs a separate functions/.gitignore with these same lines
# (without the "functions/" prefix).
# ============================================

functions/node_modules/
functions/lib/
functions/.firebase/
functions/*serviceAccount*.json
functions/*firebase-adminsdk*.json

# Firebase config for Dart-side initialization (FlutterFire CLI output).
# Same sensitivity tier as google-services.json — included here to match
# it for consistency. Same tradeoff applies: remove this line if you'd
# rather have it sync automatically via git while the repo stays Private.
lib/firebase_options.dart
